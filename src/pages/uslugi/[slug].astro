---
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { imageSize } from '../../lib/imageSize';
import home from '../../data/home.json';
import site from '../../data/site.json';
export async function getStaticPaths() {
  const items = await getCollection('services', ({ data }) => !data.draft);
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const coverSize = imageSize(d.cover);
// Пакеты и кейсы берём из тех же данных, что и на главной: цены и тексты правятся в одном месте
const packages = d.packages.map((t) => site.packages.find((p) => p.title === t)).filter(Boolean) as typeof site.packages;
const cases = (await Promise.all(d.cases.map((id) => getEntry('cases', id)))).filter((c) => c && !c.data.draft);
const others = (await getCollection('services', ({ data, id }) => !data.draft && id !== entry.id)).sort((a, b) => a.data.order - b.data.order);
const url = new URL(`/uslugi/${entry.id}/`, Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: d.name,
      description: d.description,
      url,
      areaServed: 'RU',
      provider: { '@type': 'ProfessionalService', name: site.name, url: Astro.site?.href },
      offers: { '@type': 'Offer', priceCurrency: 'RUB', price: d.price, priceSpecification: { '@type': 'PriceSpecification', minPrice: d.price, priceCurrency: 'RUB' } },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: Astro.site?.href },
        { '@type': 'ListItem', position: 2, name: 'Услуги', item: new URL('/uslugi/', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: d.name, item: url },
      ],
    },
    ...(d.faq.length ? [{
      '@type': 'FAQPage',
      mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    }] : []),
  ],
};
---
<Base title={d.title} description={d.description} image={d.cover} jsonld={jsonld}>
<main class="wrap">
  <div class="crumbs label"><a href="/uslugi/">Услуги</a> / {d.name}</div>
  <section class="svc-hero" aria-labelledby="svc-h">
    <div class="copy">
      <span class="pill">{d.label}</span>
      <h1 id="svc-h">{d.h1}</h1>
      <p class="lead">{d.lead}</p>
      <div class="facts">
        <div><span class="label">Цена</span><b>{d.priceText}</b></div>
        <div><span class="label">Срок</span><b>{d.term}</b></div>
        <div><span class="label">Правки</span><b>2 круга в цене</b></div>
      </div>
      <div class="cta">
        <a class="btn primary" href="#zayavka">Обсудить проект</a>
        {cases.length > 0 && <a class="btn ghost" href="#kejsy">Смотреть кейсы</a>}
      </div>
    </div>
    <img class="svc-cover" src={d.cover} alt={d.coverAlt} width={coverSize?.w} height={coverSize?.h} />
  </section>

  {d.includes.length > 0 && (
    <section aria-labelledby="incl-h">
      <div class="intro reveal"><span class="pill">Что входит</span><h2 id="incl-h">Что вы получите</h2></div>
      <ul class="incl reveal">{d.includes.map((i) => <li>{i}</li>)}</ul>
    </section>
  )}

  <section><article class="prose svc-text reveal"><Content /></article></section>

  {packages.length > 0 && (
    <section aria-labelledby="ceny-h">
      <div class="intro reveal"><span class="pill">Цена и сроки</span><h2 id="ceny-h">Цена фиксируется в договоре</h2><p>Без почасовой оплаты и доплат за правки. Точную сумму называем после бесплатного аудита.</p></div>
      <div class:list={['packages', { n2: packages.length === 2 }]}>
        {packages.map((p) => (
          <article class:list={['pkg', 'reveal', { main: p.featured }]}>
            <div class="label">{p.label}</div>
            <h3>{p.title}</h3>
            <div class="price">{p.price} <small>₽</small></div>
            <ul>{p.items.map((i) => <li>{i}</li>)}</ul>
            <div class="term">Срок: {p.term}</div>
          </article>
        ))}
      </div>
    </section>
  )}

  <section aria-labelledby="etapy-h">
    <div class="intro reveal"><span class="pill">Как работаем</span><h2 id="etapy-h">{home.stepsTitle}</h2></div>
    <ol class="steps reveal">{home.steps.map((st) => <li><b>{st.title}</b><span>{st.text}</span></li>)}</ol>
  </section>

  {cases.length > 0 && (
    <section id="kejsy" style="scroll-margin-top:80px" aria-labelledby="kejsy-h">
      <div class="intro reveal"><span class="pill">Кейсы</span><h2 id="kejsy-h">Примеры работ</h2></div>
      <div class="cases">
        {cases.map((c) => (
          <a class="case reveal" href={`/kejsy/${c!.id}/`}>
            {c!.data.cover && <div class="cover"><img src={c!.data.cover} alt={c!.data.client} loading="lazy" /></div>}
            <div class="tag">{c!.data.tags.map((t) => <span>{t}</span>)}</div>
            <h3>{c!.data.client}</h3>
            <p>{c!.data.summary}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  {d.faq.length > 0 && (
    <section aria-labelledby="voprosy-h">
      <div class="intro reveal"><span class="pill">Вопросы</span><h2 id="voprosy-h">Частые вопросы</h2></div>
      <div class="faq reveal">{d.faq.map((x) => <details><summary>{x.q}</summary><p>{x.a}</p></details>)}</div>
    </section>
  )}

  {others.length > 0 && (
    <section aria-labelledby="drugie-h">
      <div class="intro reveal"><span class="pill">Ещё услуги</span><h2 id="drugie-h">Что ещё делаем</h2></div>
      <div class="svc-cards">
        {others.map((s) => (
          <a class="svc-card reveal" href={`/uslugi/${s.id}/`}>
            <span class="label">{s.data.label}</span>
            <h3>{s.data.name}</h3>
            <p>{s.data.lead}</p>
            <span class="price">{s.data.priceText}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="final"><LeadForm /></section>
</main>
</Base>
