---
import Base from '../layouts/Base.astro';
import Packages from '../components/Packages.astro';
import LeadForm from '../components/LeadForm.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { sortCases } from '../lib/sortCases';
import home from '../data/home.json';
import site from '../data/site.json';

const allCases = sortCases(await getCollection('cases', ({ data }) => !data.draft));
const cases = allCases;
// Лента в герое: обложки всех кейсов в случайном порядке, слотов 9–15 (кратно трём колонкам)
const pool = allCases.map((c) => c.data.cover).filter(Boolean) as string[];
const REEL = Math.min(15, Math.max(9, Math.ceil(pool.length / 3) * 3));
const alt = (src: string) => src.split('/').pop()!.replace(/-\d+\.\w+$/, '');
const links = [
  site.telegram && { href: `https://t.me/${site.telegram}`, text: 'Написать в Telegram', primary: true },
  site.behance && { href: site.behance, text: 'Behance' },
  site.dprofile && { href: site.dprofile, text: 'Dprofile' },
  site.cvUrl && { href: site.cvUrl, text: 'Скачать CV', download: true },
  site.portfolioUrl && { href: site.portfolioUrl, text: 'Скачать портфолио', download: true },
].filter(Boolean) as { href: string; text: string; primary?: boolean; download?: boolean }[];
const stepIcons = ['search', 'contract', 'layers', 'pen', 'send'] as const;
// Заголовок первого экрана в две строки: после запятой — серым
const [titleHead, titleTail] = (() => { const i = home.hero.title.indexOf(', '); return i < 0 ? [home.hero.title, ''] : [home.hero.title.slice(0, i + 1), home.hero.title.slice(i + 2)]; })();
---
<Base title={home.seoTitle} description={home.seoDescription}>
<main>
<div class="hero-full" id="top">
<div class="wrap hero">
  <a class="badge reveal" href="#zayavka"><b>{home.hero.badgeTag}</b> {home.hero.badgeText} <i>→</i></a>
  <h1 class="reveal">{titleHead}{titleTail && <><br /><span class="dim">{titleTail}</span></>}</h1>
  <p class="lead reveal">{home.hero.lead}</p>
  <div class="cta reveal">
    <a class="btn primary" href="#zayavka">{home.hero.primary}</a>
    <a class="btn ghost" href="#kejsy">{home.hero.secondary}</a>
  </div>
</div>
</div>
<div class="wrap">
  <div class="stage reveal" aria-label="Работы студии">
    <div class="reel">
      {[0, 1, 2].map((c) => (
        <div class="col">
          {Array.from({ length: (REEL / 3) * 2 }, (_, i) => (
            <img data-slot={c + 3 * (i % (REEL / 3))} alt="" width="736" height="588" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
          ))}
        </div>
      ))}
    </div>
    <script is:inline define:vars={{ pool, REEL }}>
      // Каждый визит свой набор: перемешиваем пул и раздаём по слотам (копии слота для бесконечной прокрутки получают ту же картинку)
      const p = pool.slice();
      for (let i = p.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [p[i], p[j]] = [p[j], p[i]]; }
      document.querySelectorAll('.reel img[data-slot]').forEach((img) => { const src = p[img.dataset.slot % p.length];
        img.onerror = () => { img.onerror = null; img.src = src; };
        img.src = '/thumbs' + src.replace(/\.\w+$/, '.webp'); });
    </script>
  </div>
  {home.logos.length > 0 && (
    <div class="logos reveal">
      <div class="label">{home.logosTitle}</div>
      <div class="marquee">
        <div class="track">
          {[...home.logos, ...home.logos].map((l, i) => <img src={l.image} alt={i < home.logos.length ? l.name : ''} decoding="async" />)}
        </div>
      </div>
    </div>
  )}
</div>

<div class="wrap">
<section id="dlya-kogo" aria-labelledby="dlya-kogo-h">
  <div class="intro reveal">
    <span class="pill">Для кого</span>
    <h2 id="dlya-kogo-h">Для компаний, которым нужен дизайн</h2>
    <p>В основном это B2B: компании, которые продают другим компаниям.</p>
  </div>
  <div class="for-whom">
    {[
      { icon: 'building', title: 'Нет штатного дизайнера', text: 'Берём дизайн на себя: от логотипа до файлов для типографии.' },
      { icon: 'users', title: 'Нужен дизайнер на аутсорс', text: 'Подключаемся к задачам, когда своих рук не хватает.' },
      { icon: 'refresh', title: 'Пора обновить стиль', text: 'Делаем ребрендинг и сохраняем то, за что вас уже узнают.' },
      { icon: 'rocket', title: 'Только выходите на рынок', text: 'Собираем знак, стиль и сайт к запуску.' },
    ].map((w) => (
      <div class="fw reveal">
        <span class="ico"><Icon name={w.icon as 'building'} /></span>
        <h3>{w.title}</h3>
        <p>{w.text}</p>
      </div>
    ))}
  </div>
</section>

<section id="uslugi" aria-labelledby="uslugi-h">
  <div class="intro reveal">
    <span class="pill">{home.services.pill}</span>
    <h2 id="uslugi-h">{home.services.title}</h2>
    <p>{home.services.text}</p>
  </div>
  {home.services.items.map((f) => (
    <div class="feature">
      <div class="copy reveal">
        <span class="label">{f.label}</span>
        <h3 style="margin-top:12px">{f.title}</h3>
        <p>{f.text}</p>
        {f.bullets?.length > 0 && <ul>{f.bullets.map((b) => <li>{b}</li>)}</ul>}
        {f.linkText && <a class="link-arrow" href={f.linkUrl}>{f.linkText}</a>}
      </div>
      {f.browser ? (
        <div class="shot reveal">
          <div class="browser" aria-hidden="true">
            <div class="chrome"><i></i><i></i><i></i><span>yourcompany.ru</span></div>
            <div class="page">
              <div class="bars"><span></span><span></span><span></span><span></span></div>
              <b>{f.browserTitle}</b>
              <div class="row">{f.images.slice(0, 3).map((src) => <div style={`background-image:url(${src})`}></div>)}</div>
            </div>
          </div>
        </div>
      ) : (
        <div class:list={['shot', 'reveal', { duo: f.images.length > 1 }]}>
          {f.images.slice(0, 2).map((src) => <img src={src} alt={`${f.label}: ${alt(src)}`} loading="lazy" />)}
        </div>
      )}
    </div>
  ))}
  <div class="center"><a class="btn ghost" href="/uslugi/">Все услуги и цены</a></div>
</section>

<section aria-labelledby="pochemu-h">
  <div class="intro reveal">
    <span class="pill">Подход</span>
    <h2 id="pochemu-h">Почему с нами просто</h2>
  </div>
  <div class="bento why">
    <div class="cell wide spotlight reveal">
      <div class="why-head"><span class="ico"><Icon name="user" /></span><span class="label">Без цепочки менеджеров</span></div>
      <div class="mini" aria-hidden="true">
        <div class="msg"><span class="ava">К</span><p>Можно поправить цвет на визитке?</p></div>
        <div class="msg me"><img class="ava" src={home.about.photo} alt="" width="30" height="30" /><p>Да, пришлю сегодня</p></div>
      </div>
      <div class="why-text">
        <h3>Один ответственный</h3>
        <p>Вы общаетесь напрямую с Дмитрием: 13 лет в дизайне. Он ведёт проект от брифа до печати.</p>
      </div>
    </div>
    <div class="cell reveal">
      <div class="why-head"><span class="ico"><Icon name="contract" /></span><span class="label">Цена и срок</span></div>
      <div class="mini" aria-hidden="true">
        <div class="row"><Icon name="check" class="ok" />Логотип<b>от 45&nbsp;000&nbsp;₽</b></div>
        <div class="row"><Icon name="check" class="ok" />Срок<b>7–10 дней</b></div>
        <div class="row"><Icon name="check" class="ok" />Правки<b>2 круга</b></div>
      </div>
      <div class="why-text">
        <h3>Всё в договоре</h3>
        <p>Логотип за 7–10 рабочих дней, от 45&nbsp;000&nbsp;₽. Два круга правок входят в цену.</p>
      </div>
    </div>
    <div class="cell reveal">
      <div class="why-head"><span class="ico"><Icon name="box" /></span><span class="label">Результат</span></div>
      <div class="mini" aria-hidden="true">
        <div class="row"><span class="fi"><Icon name="file" /></span><span class="fn"><strong>Брендбук.pdf</strong><small>для подрядчиков</small></span></div>
        <div class="row"><span class="fi"><Icon name="file" /></span><span class="fn"><strong>Логотип.svg</strong><small>для сайта и соцсетей</small></span></div>
        <div class="row"><span class="fi"><Icon name="file" /></span><span class="fn"><strong>Визитка.pdf</strong><small>для типографии</small></span></div>
      </div>
      <div class="why-text">
        <h3>Сразу готово к делу</h3>
        <p>Брендбук, файлы для типографии и сайт, который находят в Яндексе.</p>
      </div>
    </div>
    <div class="cell wide reveal">
      <div class="why-head"><span class="ico"><Icon name="key" /></span><span class="label">Права</span></div>
      <div class="mini formats" aria-hidden="true">
        {[false, true].map((back) => (
          <div class:list={['fmt-track', { back }]}>
            {Array.from({ length: 4 }, () => ['AI', 'SVG', 'PDF', 'Figma']).flat().map((f) => <span class="fmt">{f}</span>)}
          </div>
        ))}
      </div>
      <div class="why-text">
        <h3>Всё остаётся вашим</h3>
        <p>Исходники в AI, SVG, PDF и Figma и исключительные права на знак передаём по договору.</p>
      </div>
    </div>
  </div>
</section>

<Packages />

<section id="kejsy" aria-labelledby="kejsy-h">
  <div class="intro reveal">
    <span class="pill">Кейсы</span>
    <h2 id="kejsy-h">{home.casesTitle}</h2>
    <p>{home.casesText}</p>
  </div>
  <div class="cases">
    {cases.map((c) => (
      <a class="case reveal" href={`/kejsy/${c.id}/`}>
        {c.data.cover && <div class="cover"><img src={c.data.cover} alt={c.data.client} loading="lazy" /></div>}
        <div class="tag">{c.data.tags.map((t) => <span>{t}</span>)}</div>
        <h3>{c.data.client}</h3>
        <p>{c.data.summary}</p>
      </a>
    ))}
  </div>
  <div class="masonry reveal" style="margin-top:12px">
    {home.gallery.map((src) => (
      <figure><img src={src} alt={alt(src)} width="736" height="588" loading="lazy" /></figure>
    ))}
  </div>
  <div class="center"><a class="btn ghost" href="/kejsy/">Все кейсы</a></div>
</section>

<section id="obo-mne" aria-labelledby="obo-mne-h">
  <div class="about-me">
    <img class="reveal" src={home.about.photo} alt={home.about.title} width="983" height="1595" loading="lazy" />
    <div class="reveal">
      <span class="pill">{home.about.pill}</span>
      <h2 id="obo-mne-h" style="margin-top:20px">{home.about.title}</h2>
      {home.about.text.map((t) => <p>{t}</p>)}
      {links.length > 0 && (
        <div class="links">
          <a class="btn ghost" href="/obo-mne/">Подробнее обо мне</a>
          {links.map((l) => <a class:list={['btn', l.primary ? 'primary' : 'ghost']} href={l.href} target={l.download ? undefined : '_blank'} rel="noopener" download={l.download || undefined}>{l.text}</a>)}
        </div>
      )}
    </div>
  </div>
</section>

<section id="etapy" aria-labelledby="etapy-h">
  <div class="intro reveal">
    <span class="pill">Как работаем</span>
    <h2 id="etapy-h">{home.stepsTitle}</h2>
  </div>
  <ol class="steps reveal">
    {home.steps.map((st, i) => <li><span class="ico"><Icon name={stepIcons[i % stepIcons.length]} /></span><b>{st.title}</b><span>{st.text}</span></li>)}
  </ol>
</section>

<section id="voprosy" aria-labelledby="voprosy-h">
  <div class="intro reveal"><span class="pill">Вопросы</span><h2 id="voprosy-h">Частые вопросы</h2></div>
  <div class="faq reveal">
    {home.faq.map((x) => <details><summary>{x.q}</summary><p>{x.a}</p></details>)}
  </div>
</section>

<section class="final" aria-labelledby="final-h">
  <div class="reveal">
    <h2 id="final-h">{home.final.title}</h2>
    <p class="lead" style="margin:24px auto 0;color:var(--muted);font-size:19px">{home.final.text}</p>
  </div>
  <LeadForm />
</section>
</div>
</main>
</Base>
