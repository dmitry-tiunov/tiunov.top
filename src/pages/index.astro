---
import Base from '../layouts/Base.astro';
import Packages from '../components/Packages.astro';
import LeadForm from '../components/LeadForm.astro';
import { getCollection } from 'astro:content';
import home from '../data/home.json';
import site from '../data/site.json';

const allCases = (await getCollection('cases', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const cases = allCases;
// Лента в герое: обложки всех кейсов в случайном порядке, слотов 9–15 (кратно трём колонкам)
const pool = allCases.map((c) => c.data.cover).filter(Boolean) as string[];
const REEL = Math.min(15, Math.max(9, Math.ceil(pool.length / 3) * 3));
const alt = (src: string) => src.split('/').pop()!.replace(/-\d+\.\w+$/, '');
const links = [
  site.telegram && { href: `https://t.me/${site.telegram}`, text: 'Написать в Telegram', primary: true },
  site.behance && { href: site.behance, text: 'Behance' },
  site.dprofile && { href: site.dprofile, text: 'Dprofile' },
  site.cvUrl && { href: site.cvUrl, text: 'Скачать CV', download: true },
  site.portfolioUrl && { href: site.portfolioUrl, text: 'Скачать портфолио', download: true },
].filter(Boolean) as { href: string; text: string; primary?: boolean; download?: boolean }[];
---
<Base title={home.seoTitle} description={home.seoDescription}>
<main>
<div class="hero-full" id="top">
<div class="wrap hero">
  <a class="badge reveal" href="#zayavka"><b>{home.hero.badgeTag}</b> {home.hero.badgeText} <i>→</i></a>
  <h1 class="reveal">{home.hero.title}</h1>
  <p class="lead reveal">{home.hero.lead}</p>
  <div class="cta reveal">
    <a class="btn primary" href="#zayavka">{home.hero.primary}</a>
    <a class="btn ghost" href="#kejsy">{home.hero.secondary}</a>
  </div>
</div>
</div>
<div class="wrap">
  <div class="stage reveal" aria-label="Работы студии">
    <div class="reel">
      {[0, 1, 2].map((c) => (
        <div class="col">
          {Array.from({ length: (REEL / 3) * 2 }, (_, i) => (
            <img data-slot={c + 3 * (i % (REEL / 3))} alt="" width="736" height="588" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
          ))}
        </div>
      ))}
    </div>
    <script is:inline define:vars={{ pool, REEL }}>
      // Каждый визит свой набор: перемешиваем пул и раздаём по слотам (копии слота для бесконечной прокрутки получают ту же картинку)
      const p = pool.slice();
      for (let i = p.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [p[i], p[j]] = [p[j], p[i]]; }
      document.querySelectorAll('.reel img[data-slot]').forEach((img) => { const src = p[img.dataset.slot % p.length];
        img.onerror = () => { img.onerror = null; img.src = src; };
        img.src = '/thumbs' + src.replace(/\.\w+$/, '.webp'); });
    </script>
  </div>
  {home.logos.length > 0 && (
    <div class="logos reveal">
      <div class="label">{home.logosTitle}</div>
      <div class="marquee">
        <div class="track">
          {[...home.logos, ...home.logos].map((l, i) => <img src={l.image} alt={i < home.logos.length ? l.name : ''} decoding="async" />)}
        </div>
      </div>
    </div>
  )}
</div>

<div class="wrap">
<section id="uslugi" aria-labelledby="uslugi-h">
  <div class="intro reveal">
    <span class="pill">{home.services.pill}</span>
    <h2 id="uslugi-h">{home.services.title}</h2>
    <p>{home.services.text}</p>
  </div>
  {home.services.items.map((f) => (
    <div class="feature">
      <div class="copy reveal">
        <span class="label">{f.label}</span>
        <h3 style="margin-top:12px">{f.title}</h3>
        <p>{f.text}</p>
        {f.bullets?.length > 0 && <ul>{f.bullets.map((b) => <li>{b}</li>)}</ul>}
        {f.linkText && <a class="link-arrow" href={f.linkUrl}>{f.linkText}</a>}
      </div>
      {f.browser ? (
        <div class="shot reveal">
          <div class="browser" aria-hidden="true">
            <div class="chrome"><i></i><i></i><i></i><span>yourcompany.ru</span></div>
            <div class="page">
              <div class="bars"><span></span><span></span><span></span><span></span></div>
              <b>{f.browserTitle}</b>
              <div class="row">{f.images.slice(0, 3).map((src) => <div style={`background-image:url(${src})`}></div>)}</div>
            </div>
          </div>
        </div>
      ) : (
        <div class:list={['shot', 'reveal', { duo: f.images.length > 1 }]}>
          {f.images.slice(0, 2).map((src) => <img src={src} alt={`${f.label}: ${alt(src)}`} loading="lazy" />)}
        </div>
      )}
    </div>
  ))}
</section>

<section aria-labelledby="pochemu-h">
  <div class="intro reveal">
    <span class="pill">Почему с нами проще</span>
    <h2 id="pochemu-h">Не просто логотип, а готовая система</h2>
  </div>
  <div class="bento">
    <div class="cell reveal">
      <span class="label">Сроки</span>
      <div class="big-num">7 <small>рабочих дней до логотипа</small></div>
      <div class="ui">
        <div class="timeline"><span class="on"></span><span class="on"></span><span class="on"></span><span></span><span></span></div>
        <div class="kv">Аудит, смета, концепции <b>готово</b></div>
      </div>
    </div>
    <div class="cell reveal">
      <h3>Цена фиксируется в договоре</h3>
      <p>Без почасовой оплаты и доплат за правки.</p>
      <div class="ui">
        <div class="kv">Пакет <b>Стиль и сайт</b></div>
        <div class="kv">Круги правок <b>2 включены</b></div>
        <div class="kv">Итого <b>от 140 000 ₽</b></div>
        <div class="kv">Статус <span class="ok">ЗАФИКСИРОВАНО</span></div>
      </div>
    </div>
    <div class="cell reveal">
      <h3>Сайт, который любит Яндекс</h3>
      <p>Быстрый, с микроразметкой и картой сайта.</p>
      <div class="ui">
        <div class="kv">Загрузка (LCP) <b>1,1 с</b></div>
        <div class="kv">Отклик (INP) <b>80 мс</b></div>
        <div class="kv">Скорость <span class="ok">ХОРОШО</span></div>
      </div>
    </div>
    <div class="cell wide spotlight reveal">
      <span class="label">Без цепочки менеджеров</span>
      <h3>Вы общаетесь напрямую с дизайнером с 13-летним опытом</h3>
      <table>
        <thead><tr><th>Ориентир, рабочие дни</th><th class="num">Агентство</th><th class="num">Студия</th></tr></thead>
        <tbody>
          <tr><td>Логотип</td><td class="num">15–20</td><td class="num">7–10</td></tr>
          <tr><td>Фирстиль и сайт</td><td class="num">40–60</td><td class="num">15–20</td></tr>
        </tbody>
      </table>
    </div>
    <div class="cell reveal">
      <h3>Брендбук на каждый случай</h3>
      <div class="ui">
        <div class="swatches"><i style="background:#0099ff"></i><i style="background:#ff5a1f"></i><i style="background:#f3eadf"></i><i style="background:#171717;box-shadow:inset 0 0 0 1px #333"></i></div>
        <div class="specimen"><b>Аа</b><span class="label">Шрифты, сетки, графика</span></div>
      </div>
    </div>
    <div class="cell reveal">
      <h3>Готово к печати</h3>
      <p>Файлы под типографию, подбор материалов, цветопроба.</p>
      <div class="ui">
        <div class="kv">Формат <b>PDF/X-1a, CMYK</b></div>
        <div class="kv">Цветопроба <span class="ok">ПРИНЯТА</span></div>
      </div>
    </div>
    <div class="cell wide reveal">
      <h3>Права остаются у вас</h3>
      <p>Исключительные права на знак и все материалы передаются по договору. Можно регистрировать товарный знак.</p>
      <div class="ui"><div class="kv">Исходники <b>AI, SVG, PDF, Figma</b></div></div>
    </div>
  </div>
</section>

<Packages />

<section id="kejsy" aria-labelledby="kejsy-h">
  <div class="intro reveal">
    <span class="pill">Кейсы</span>
    <h2 id="kejsy-h">{home.casesTitle}</h2>
    <p>{home.casesText}</p>
  </div>
  <div class="cases">
    {cases.map((c) => (
      <a class="case reveal" href={`/kejsy/${c.id}/`}>
        {c.data.cover && <div class="cover"><img src={c.data.cover} alt={c.data.client} loading="lazy" /></div>}
        <div class="tag">{c.data.tags.map((t) => <span>{t}</span>)}</div>
        <h3>{c.data.client}</h3>
        <p>{c.data.summary}</p>
      </a>
    ))}
  </div>
  <div class="masonry reveal" style="margin-top:12px">
    {home.gallery.map((src) => (
      <figure><img src={src} alt={alt(src)} width="736" height="588" loading="lazy" /></figure>
    ))}
  </div>
  <div class="center"><a class="btn ghost" href="/kejsy/">Все кейсы</a></div>
</section>

<section id="obo-mne" aria-labelledby="obo-mne-h">
  <div class="about-me">
    <img class="reveal" src={home.about.photo} alt={home.about.title} width="983" height="1595" loading="lazy" />
    <div class="reveal">
      <span class="pill">{home.about.pill}</span>
      <h2 id="obo-mne-h" style="margin-top:20px">{home.about.title}</h2>
      {home.about.text.map((t) => <p>{t}</p>)}
      {links.length > 0 && (
        <div class="links">
          {links.map((l) => <a class:list={['btn', l.primary ? 'primary' : 'ghost']} href={l.href} target={l.download ? undefined : '_blank'} rel="noopener" download={l.download || undefined}>{l.text}</a>)}
        </div>
      )}
    </div>
  </div>
</section>

<section id="etapy" aria-labelledby="etapy-h">
  <div class="intro reveal">
    <span class="pill">Как работаем</span>
    <h2 id="etapy-h">{home.stepsTitle}</h2>
  </div>
  <ol class="steps reveal">
    {home.steps.map((st) => <li><b>{st.title}</b><span>{st.text}</span></li>)}
  </ol>
</section>

<section id="voprosy" aria-labelledby="voprosy-h">
  <div class="intro reveal"><span class="pill">Вопросы</span><h2 id="voprosy-h">Частые вопросы</h2></div>
  <div class="faq reveal">
    {home.faq.map((x) => <details><summary>{x.q}</summary><p>{x.a}</p></details>)}
  </div>
</section>

<section class="final" aria-labelledby="final-h">
  <div class="reveal">
    <h2 id="final-h">{home.final.title}</h2>
    <p class="lead" style="margin:24px auto 0;color:var(--muted);font-size:19px">{home.final.text}</p>
    <div class="chips" role="group" aria-label="Что нужно">
      {home.final.chips.map((c) => <button type="button" data-chip={c}>{c}</button>)}
    </div>
  </div>
  <LeadForm />
</section>
</div>
</main>
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-chip]').forEach((b) => b.addEventListener('click', () => {
    const msg = document.getElementById('f-msg') as HTMLTextAreaElement | null;
    if (msg && !msg.value.includes(b.dataset.chip!)) msg.value = (msg.value ? msg.value + ', ' : 'Нужно: ') + b.dataset.chip;
    document.getElementById('f-name')?.focus({ preventScroll: true });
    document.getElementById('zayavka')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }));
</script>
</Base>
