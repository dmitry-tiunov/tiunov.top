---
import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import { getCollection, render } from 'astro:content';
import { imageSize } from '../../lib/imageSize';
export async function getStaticPaths() {
  const items = await getCollection('cases', ({ data }) => !data.draft);
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
// Сетка: картинки до 1400px идут парами, широкие (от 1400px) занимают всю строку
const gallery = entry.data.gallery.map((src) => {
  const size = imageSize(src);
  return { src, size, wide: !!size && size.w >= 1400 };
});
// Узкая картинка без пары (перед широкой или в конце) тоже идёт на всю ширину, чтобы не было пустого места
let run = 0;
gallery.forEach((g, i) => {
  if (g.wide) return void (run = 0);
  run++;
  const next = gallery[i + 1];
  if (run % 2 === 1 && (!next || next.wide)) g.wide = true;
});
const coverSize = entry.data.cover ? imageSize(entry.data.cover) : null;
---
<Base title={entry.data.title} description={entry.data.description}>
<div class="wrap">
  <div class="crumbs label"><a href="/kejsy/">Кейсы</a> / {entry.data.client}</div>
  <div style="padding-top:32px">
    <div class="tags">{entry.data.tags.map((t) => <span>{t}</span>)}</div>
    <h1 style="margin-top:20px">{entry.data.client}</h1>
    <p style="margin-top:20px;color:var(--muted);font-size:19px;line-height:1.4">{entry.data.summary}</p>
  </div>
  {entry.data.cover && <img class="case-hero reveal" src={entry.data.cover} alt={entry.data.client} width={coverSize?.w} height={coverSize?.h} />}
  <article class="prose" style="padding-block:48px">
    <Content />
  </article>
  {gallery.length > 0 && (
    <div class="gallery">{gallery.map((g) => <img class:list={['reveal', { wide: g.wide }]} src={g.src} alt={entry.data.client} width={g.size?.w} height={g.size?.h} loading="lazy" decoding="async" />)}</div>
  )}
  <section><LeadForm /></section>
</div>
</Base>
