---
import '@fontsource/geist/cyrillic-500.css';
import '@fontsource/geist/cyrillic-600.css';
import '@fontsource/geist/latin-500.css';
import '@fontsource/geist/latin-600.css';
import '@fontsource/inter/cyrillic-400.css';
import '@fontsource/inter/cyrillic-500.css';
import '@fontsource/inter/cyrillic-700.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-700.css';
import '../styles/global.css';
import site from '../data/site.json';

interface Props { title: string; description: string; noindex?: boolean; jsonld?: object; image?: string }
const { title, description, noindex = false, jsonld, image = '/og-default.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const org = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  url: Astro.site?.href,
  logo: new URL('/icon-512.png', Astro.site).href,
  image: new URL('/og-default.png', Astro.site).href,
  telephone: site.phone,
  ...(site.email ? { email: site.email } : {}),
  sameAs: [site.telegram && `https://t.me/${site.telegram}`, site.behance, site.dprofile, site.yandexMaps].filter(Boolean),
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressCountry: 'RU' },
  areaServed: 'RU',
};
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <link rel="icon" href="/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">
  <meta name="theme-color" content="#000000">
  <script is:inline>
    // Тема до отрисовки, чтобы страница не мигала: выбор посетителя, иначе тема системы
    (function () {
      var t = null;
      try { t = localStorage.getItem('theme'); } catch (e) {}
      if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      document.documentElement.dataset.theme = t;
      document.querySelector('meta[name="theme-color"]').content = t === 'light' ? '#ffffff' : '#000000';
    })();
  </script>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={site.name}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:locale" content="ru_RU">
  <meta name="twitter:card" content="summary_large_image">
  <script is:inline>document.documentElement.classList.add('js')</script>
  {site.yandexVerification && <meta name="yandex-verification" content={site.yandexVerification} />}
  {site.googleVerification && <meta name="google-site-verification" content={site.googleVerification} />}
  {site.metrikaId && (
    <script is:inline define:vars={{ id: Number(site.metrikaId) }}>
      (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();
      for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
      k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
      (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
      ym(id, "init", { ssr: true, clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: true, referrer: document.referrer, url: location.href });
      window.__ymId = id;
      // Цели: клик в Telegram, MAX, звонок, почта, скачивание CV и портфолио
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a'); if (!a) return;
        var h = a.getAttribute('href') || '';
        var goal = h.indexOf('t.me/') > -1 ? 'telegram' : h.indexOf('max.ru/') > -1 ? 'max' : h.indexOf('tel:') === 0 ? 'phone' : h.indexOf('mailto:') === 0 ? 'email' : a.hasAttribute('download') ? 'download' : '';
        if (goal) ym(id, 'reachGoal', goal);
      });
    </script>
  )}
  <link rel="sitemap" href="/sitemap-index.xml">
  <script type="application/ld+json" set:html={JSON.stringify(org)} />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
  {site.metrikaId && <noscript><div><img src={`https://mc.yandex.ru/watch/${site.metrikaId}`} style="position:absolute;left:-9999px" alt="" /></div></noscript>}
  <header class="top">
    <div class="wrap bar">
      <a class="logo" href="/" aria-label="Design Tiunov, на главную"><img class="logo-mark" src="/mark.svg" alt="" width="481" height="430" /><img src="/logo.svg" alt="Design Tiunov" width="1349" height="98" /></a>
      <nav class="main" aria-label="Разделы">
        <a href="/uslugi/">Услуги</a>
        <a href="/kejsy/">Кейсы</a>
        <a href="/#pakety">Цены</a>
        <a href="/obo-mne/">Обо мне</a>
        <a href="/blog/">Блог</a>
      </nav>
      <div class="bar-end">
        <button class="theme-toggle" type="button" aria-label="Переключить тему">
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
        </button>
        <a class="btn primary sm" href="/#zayavka">Обсудить проект</a>
        <button class="burger" type="button" aria-label="Открыть меню" aria-expanded="false" aria-controls="mnav"><span></span><span></span></button>
      </div>
    </div>
    <div class="mnav" id="mnav" hidden>
      <nav class="wrap" aria-label="Меню">
        <a href="/uslugi/">Услуги</a>
        <a href="/kejsy/">Кейсы</a>
        <a href="/#pakety">Цены</a>
        <a href="/obo-mne/">Обо мне</a>
        <a href="/blog/">Блог</a>
      </nav>
      <div class="wrap mnav-foot">
        <a class="btn primary" href="/#zayavka">Обсудить проект</a>
        {site.telegram && <a class="btn ghost" href={`https://t.me/${site.telegram}`}>Telegram</a>}
        {site.phone && <a class="mnav-phone" href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a>}
      </div>
    </div>
  </header>
  <slot />
  <footer class="site">
    <div class="wrap">
      <div class="cols">
        <div class="about">
          <a class="logo" href="/" aria-label="Design Tiunov, на главную"><img class="logo-mark" src="/mark.svg" alt="" width="481" height="430" /><img src="/logo.svg" alt="Design Tiunov" width="1349" height="98" /></a>
          <p>Фирменный стиль, сайты и носители для бизнеса. Работаем по всей России.</p>
        </div>
        <div><h4>Услуги</h4><ul>
          <li><a href="/uslugi/razrabotka-logotipa/">Разработка логотипа</a></li>
          <li><a href="/uslugi/firmennyj-stil/">Фирменный стиль</a></li>
          <li><a href="/uslugi/brendbuk/">Брендбук</a></li>
          <li><a href="/uslugi/">Сайты, транспорт, мерч</a></li>
        </ul></div>
        <div><h4>Студия</h4><ul>
          <li><a href="/obo-mne/">Обо мне</a></li>
          <li><a href="/kejsy/">Кейсы</a></li>
          <li><a href="/#pakety">Пакеты и цены</a></li>
          <li><a href="/blog/">Блог</a></li>
          <li><a href="/#voprosy">Вопросы</a></li>
        </ul></div>
        <div><h4>Связаться</h4><ul>
          <li><a href={`https://t.me/${site.telegram}`}>Telegram</a></li>
          <li><a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a></li>
          {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
          {site.behance && <li><a href={site.behance} target="_blank" rel="noopener">Behance</a></li>}
          {site.dprofile && <li><a href={site.dprofile} target="_blank" rel="noopener">Dprofile</a></li>}
          {site.yandexMaps && <li><a href={site.yandexMaps} target="_blank" rel="noopener">Яндекс Карты</a></li>}
          {site.cvUrl && <li><a href={site.cvUrl} download>Скачать CV</a></li>}
          {site.portfolioUrl && <li><a href={site.portfolioUrl} download>Скачать портфолио</a></li>}
          <li><a href="/#zayavka">Оставить заявку</a></li>
        </ul></div>
      </div>
      <div class="legal">
        <span>© {new Date().getFullYear()} {site.name} · {site.city}</span>
        <a href="/privacy/" style="color:inherit">Политика обработки персональных данных</a>
      </div>
    </div>
  </footer>
  <script>
    const burger = document.querySelector('.burger');
    const mnav = document.getElementById('mnav');
    const setMenu = (open) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
      mnav.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
    };
    burger.addEventListener('click', () => setMenu(mnav.hidden));
    mnav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !mnav.hidden) setMenu(false); });
    matchMedia('(min-width:811px)').addEventListener('change', (e) => { if (e.matches) setMenu(false); });

    const root = document.documentElement;
    const toggle = document.querySelector('.theme-toggle');
    const setTheme = (t, save) => {
      root.dataset.theme = t;
      document.querySelector('meta[name="theme-color"]').content = t === 'light' ? '#ffffff' : '#000000';
      toggle.setAttribute('aria-label', t === 'light' ? 'Включить тёмную тему' : 'Включить светлую тему');
      if (save) try { localStorage.setItem('theme', t); } catch (e) {}
    };
    setTheme(root.dataset.theme, false);
    toggle.addEventListener('click', () => setTheme(root.dataset.theme === 'light' ? 'dark' : 'light', true));
    // Пока посетитель сам не выбрал тему, следуем за системой
    matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
      let saved = null;
      try { saved = localStorage.getItem('theme'); } catch (err) {}
      if (!saved) setTheme(e.matches ? 'light' : 'dark', false);
    });

    const els = document.querySelectorAll('.reveal');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      els.forEach((el) => io.observe(el));
    } else els.forEach((el) => el.classList.add('in'));
  </script>
</body>
</html>
