---
import site from '../data/site.json';
import home from '../data/home.json';
// Форма Яндекс Форм: данные хранятся в России (152-ФЗ). Ссылка вида https://forms.yandex.ru/u/<id>/
const yaId = site.formEmbed?.match(/forms\.yandex\.ru\/(?:u|cloud)\/([\w-]+)/)?.[1];
// Пока заявки не принимаются формой (нет formEmbed и formEndpoint), показываем кнопки «написать».
// Текст для Telegram и письма собирается в скрипте ниже: теги «Что нужно» дописывают в него выбранное.
const contactOnly = !yaId && !site.formEndpoint;
const needs = home.final.chips;
const greeting = 'Здравствуйте! Хочу бесплатный аудит бренда и сайта.';
const tgHref = site.telegram && `https://t.me/${site.telegram}?text=${encodeURIComponent(greeting)}`;
const mailHref = site.email && `mailto:${site.email}?subject=${encodeURIComponent('Аудит бренда и сайта')}&body=${encodeURIComponent(greeting)}`;
---
<div id="zayavka" class="lead-form reveal" style="scroll-margin-top:80px">
  <div class="lf-intro">
    <span class="lf-badge"><i></i>Бесплатно · ответ за 1 рабочий день</span>
    <h3 id="zayavka-h">Аудит вашего бренда и сайта</h3>
    <p>Пришлите сайт компании. Вернёмся со списком того, что мешает продажам, и сметой.</p>
    <div class="lf-person">
      <img src={home.about.photo} alt="" width="48" height="48" loading="lazy" />
      <div><b>Дмитрий Тиунов</b><span>Отвечает лично</span></div>
    </div>
  </div>
  <div class="lf-act">
    {!yaId && needs.length > 0 && (
      <fieldset class="needs">
        <legend class="label">{contactOnly && <span class="num">1</span>}Что нужно? Можно выбрать несколько</legend>
        <div class="chips">
          {needs.map((c) => <button type="button" data-chip={c} aria-pressed="false">{c}</button>)}
        </div>
        {contactOnly
          ? <p class="msg-preview" aria-live="polite">Текст сообщения: «<span data-preview>{greeting}</span>»</p>
          : <p class="msg-preview">Выбранное добавим в комментарий к заявке.</p>}
      </fieldset>
    )}
    {contactOnly ? (
      <div class="contact" data-greeting={greeting}>
        <div class="label step"><span class="num">2</span>Напишите, где вам удобно</div>
        <div class="contact-actions">
          {tgHref && <a class="btn primary" href={tgHref} data-tg={site.telegram} target="_blank" rel="noopener">Написать в Telegram</a>}
          {site.max && <a class="btn ghost" href={site.max} target="_blank" rel="noopener">Написать в MAX</a>}
          {mailHref && <a class="btn ghost" href={mailHref} data-mail={site.email}>Написать на почту</a>}
        </div>
        {site.email && (
          <p class="contact-mail">Почта: <b>{site.email}</b> <button type="button" class="btn ghost sm" data-copy={site.email}>Скопировать</button></p>
        )}
      </div>
    ) : yaId ? (
      <div class="ya-form"><iframe src={`https://forms.yandex.ru/u/${yaId}/?iframe=1&theme=dark`} name={`ya-form-${yaId}`} title="Форма заявки" loading="lazy" style="width:100%;min-height:640px;border:0"></iframe></div>
    ) : (
    <form id="lead" data-endpoint={site.formEndpoint} data-tg={site.telegram} data-phone={site.phone} novalidate>
      <label>Имя<input id="f-name" name="name" required autocomplete="name"></label>
      <label>Телефон или Telegram<input id="f-contact" name="contact" required></label>
      <label>Компания и сайт<input id="f-site" name="site" placeholder="company.ru"></label>
      <label>Что нужно<select id="f-pkg" name="pkg"><option>Пока не знаю, нужен аудит</option>{site.packages.map((p) => <option>{p.title}</option>)}</select></label>
      <label class="full">Комментарий<textarea id="f-msg" name="msg" placeholder="Например: старому логотипу 15 лет, весной выставка"></textarea></label>
      <p class="full consent">Нажимая кнопку, вы соглашаетесь на <a href="/privacy/" style="color:inherit">обработку персональных данных</a>.</p>
      <div class="full" style="display:flex;gap:16px;align-items:center;flex-wrap:wrap">
        <button class="btn primary" type="submit">Отправить заявку</button>
        <span id="form-msg" role="status"></span>
      </div>
    </form>
    )}
  </div>
</div>
{yaId && <script is:inline src="https://forms.yandex.ru/_static/embed.js"></script>}
<script>
  const form = document.getElementById('lead') as HTMLFormElement | null;
  const msg = document.getElementById('form-msg')!;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    if (!String(data.get('name')).trim() || !String(data.get('contact')).trim()) {
      msg.textContent = 'Укажите имя и телефон или Telegram.';
      return;
    }
    const endpoint = form.dataset.endpoint;
    if (!endpoint) { msg.innerHTML = `Форма скоро заработает. Пока напишите в <a href="https://t.me/${form.dataset.tg}" target="_blank" rel="noopener">Telegram</a> или позвоните ${form.dataset.phone}.`; return; }
    msg.textContent = 'Отправляем…';
    try {
      const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error();
      form.reset();
      msg.textContent = 'Заявка отправлена. Ответим в течение рабочего дня.';
      const w = window as any; if (w.__ymId) w.ym?.(w.__ymId, 'reachGoal', 'lead');
    } catch {
      msg.textContent = 'Не получилось отправить. Напишите в Telegram или позвоните.';
    }
  });

  // Теги «Что нужно»: нажатие выбирает, повторное снимает. Выбранное попадает
  // в текст сообщения Telegram и письма (с предпросмотром) или в комментарий формы.
  const chips = [...document.querySelectorAll<HTMLButtonElement>('#zayavka [data-chip]')];
  const contact = document.querySelector<HTMLElement>('#zayavka .contact');
  const tg = contact?.querySelector<HTMLAnchorElement>('[data-tg]');
  const mail = contact?.querySelector<HTMLAnchorElement>('[data-mail]');
  const preview = document.querySelector<HTMLElement>('#zayavka [data-preview]');
  chips.forEach((b) => b.addEventListener('click', () => {
    const on = b.getAttribute('aria-pressed') !== 'true';
    b.setAttribute('aria-pressed', String(on));
    b.classList.toggle('on', on);
    const needs = chips.filter((c) => c.classList.contains('on')).map((c) => c.dataset.chip!);
    const comment = document.getElementById('f-msg') as HTMLTextAreaElement | null;
    if (comment) {
      // В форме выбранное держим первой строкой «Нужно: …», остальной текст не трогаем.
      const rest = comment.value.replace(/^Нужно: [^\n]*\n?/, '');
      comment.value = (needs.length ? `Нужно: ${needs.join(', ')}\n` : '') + rest;
    }
    if (contact) {
      const text = contact.dataset.greeting + (needs.length ? ` Нужно: ${needs.join(', ')}.` : '');
      if (tg) tg.href = `https://t.me/${tg.dataset.tg}?text=${encodeURIComponent(text)}`;
      if (mail) mail.href = `mailto:${mail.dataset.mail}?subject=${encodeURIComponent('Аудит бренда и сайта')}&body=${encodeURIComponent(text)}`;
      if (preview) preview.textContent = text;
    }
  }));
  if (contact) {
    contact.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async (e) => {
      const b = e.currentTarget as HTMLButtonElement;
      try { await navigator.clipboard.writeText(b.dataset.copy!); b.textContent = 'Скопировано'; }
      catch { b.textContent = 'Не получилось, выделите адрес'; }
    });
  }
</script>
