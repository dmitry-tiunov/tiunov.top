---
import site from '../data/site.json';
// Форма Яндекс Форм: данные хранятся в России (152-ФЗ). Ссылка вида https://forms.yandex.ru/u/<id>/
const yaId = site.formEmbed?.match(/forms\.yandex\.ru\/(?:u|cloud)\/([\w-]+)/)?.[1];
---
<div id="zayavka" class="lead-form reveal" style="scroll-margin-top:80px">
    <div class="label">Бесплатно · ответ за 1 рабочий день</div>
    <h3 id="zayavka-h" style="margin-top:12px">Аудит вашего бренда и сайта</h3>
    <p style="margin-top:12px;opacity:.8">Пришлите сайт компании. Вернёмся со списком того, что мешает продажам, и сметой.</p>
    {yaId ? (
      <div class="ya-form"><iframe src={`https://forms.yandex.ru/u/${yaId}/?iframe=1&theme=dark`} name={`ya-form-${yaId}`} title="Форма заявки" loading="lazy" style="width:100%;min-height:640px;border:0"></iframe></div>
    ) : (
    <form id="lead" data-endpoint={site.formEndpoint} data-tg={site.telegram} data-phone={site.phone} novalidate>
      <label>Имя<input id="f-name" name="name" required autocomplete="name"></label>
      <label>Телефон или Telegram<input id="f-contact" name="contact" required></label>
      <label>Компания и сайт<input id="f-site" name="site" placeholder="company.ru"></label>
      <label>Что нужно<select id="f-pkg" name="pkg"><option>Пока не знаю, нужен аудит</option>{site.packages.map((p) => <option>{p.title}</option>)}</select></label>
      <label class="full">Комментарий<textarea id="f-msg" name="msg" placeholder="Например: старому логотипу 15 лет, весной выставка"></textarea></label>
      <p class="full consent">Нажимая кнопку, вы соглашаетесь на <a href="/privacy/" style="color:inherit">обработку персональных данных</a>.</p>
      <div class="full" style="display:flex;gap:16px;align-items:center;flex-wrap:wrap">
        <button class="btn primary" type="submit">Отправить заявку</button>
        <span id="form-msg" role="status"></span>
      </div>
    </form>
    )}
</div>
{yaId && <script is:inline src="https://forms.yandex.ru/_static/embed.js"></script>}
<script>
  const form = document.getElementById('lead') as HTMLFormElement | null;
  const msg = document.getElementById('form-msg')!;
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    if (!String(data.get('name')).trim() || !String(data.get('contact')).trim()) {
      msg.textContent = 'Укажите имя и телефон или Telegram.';
      return;
    }
    const endpoint = form.dataset.endpoint;
    if (!endpoint) { msg.innerHTML = `Форма скоро заработает. Пока напишите в <a href="https://t.me/${form.dataset.tg}" target="_blank" rel="noopener">Telegram</a> или позвоните ${form.dataset.phone}.`; return; }
    msg.textContent = 'Отправляем…';
    try {
      const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
      if (!res.ok) throw new Error();
      form.reset();
      msg.textContent = 'Заявка отправлена. Ответим в течение рабочего дня.';
      const w = window as any; if (w.__ymId) w.ym?.(w.__ymId, 'reachGoal', 'lead');
    } catch {
      msg.textContent = 'Не получилось отправить. Напишите в Telegram или позвоните.';
    }
  });
</script>
