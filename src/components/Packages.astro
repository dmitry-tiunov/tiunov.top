---
import site from '../data/site.json';
---
<section id="pakety" style="scroll-margin-top:40px" aria-labelledby="pakety-h">
  <div class="intro reveal"><span class="pill">Пакеты и цены</span><h2 id="pakety-h">Понятная цена до старта</h2><p>Цена фиксируется в договоре. Без почасовой оплаты и доплат за правки.</p></div>
  <div class="packages">
    {site.packages.map((p) => (
      <article class:list={['pkg', 'reveal', { main: p.featured }]}>
        <div class="label">{p.label}</div>
        <h3>{p.title}</h3>
        <div class="price">{p.price} <small>₽</small></div>
        <ul>{p.items.map((i) => <li>{i}</li>)}</ul>
        <div class="term">Срок: {p.term}</div>
      </article>
    ))}
  </div>
</section>
